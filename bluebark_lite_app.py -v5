from collections import deque

NOISE_WINDOW_S = 20.0      # hoe lang ruis wordt meegenomen
MIN_MARGIN_DB = 3.0        # minimale afstand drempel boven ruis
MAD_FACTOR = 4.0           # gevoeligheid t.o.v. ruisspreiding
CONFIRM_HITS = 2           # aantal metingen op rij voor alarm

class NoiseTracker:
    def __init__(self):
        self.samples = deque()
    def reset(self):
        self.samples.clear()
    def add(self, now, db):
        self.samples.append((now, db))
        while self.samples and now - self.samples[0][0] > NOISE_WINDOW_S:
            self.samples.popleft()
    def threshold(self, user_offset):
        if len(self.samples) < 30:
            return None
        vals = sorted(v for _, v in self.samples)
        median = vals[len(vals) // 2]
        mad = sorted(abs(v - median) for v in vals)[len(vals) // 2]
        return median + max(MIN_MARGIN_DB, MAD_FACTOR * mad) + user_offset

