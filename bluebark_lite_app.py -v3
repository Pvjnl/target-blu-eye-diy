@app.route('/')
def index():
    return render_template_string(HTML_TEMPLATE)

@app.route('/api/state')
def get_state():
    return jsonify({
        "smoothed_steps": state.smoothed_steps,
        "peak_step": state.peak_step,
        "is_alarm": state.current_is_alarm,
        "floor_db": int(state.floor_db) if state.is_auto_floor else state.floor_db,
        "active_mode": state.active_mode,
        "current_gain": state.current_gain,
        "text_peak_db": int(state.text_peak_db) if state.text_peak_db > NOISE_FLOOR_ESTIMATE else "---",
        "cpu_temp": get_cpu_temp()
    })

@app.route('/api/action', methods=['POST'])
def do_action():
    action = request.json.get('action')
    if action == "squelch_up":
        set_floor_db(state.floor_db + STEP_SIZE, auto=False)
    elif action == "squelch_down":
        set_floor_db(state.floor_db - STEP_SIZE, auto=False)
    elif action == "mode_long":
        state.active_mode = next_mode()
        restart_sdr()
    elif action == "set_gain":
        new_gain = request.json.get('value', DEFAULT_GAIN)
        state.current_gain = new_gain
        restart_sdr()
    return jsonify({"status": "ok"})

# --- STARTUP ---
if __name__ == "__main__":
    threading.Thread(target=sdr_manager_thread, daemon=True).start()
    threading.Thread(target=logic_loop, daemon=True).start()
    
    app.run(host="0.0.0.0", port=80)
