@app.route('/api/state')
def get_state():
    learn_pct = min(100, int(100 * noise.count() / NOISE_MIN_SAMPLES))
    has_peak = state.text_peak_db != NO_DATA_VALUE
    return jsonify({
        "status": status_text(),
        "learn_pct": learn_pct,
        "is_alarm": state.current_is_alarm,
        "active_mode": state.active_mode,
        "current_gain": state.current_gain,
        "noise_db": r1(state.noise_db),
        "noise_spread_db": r1(state.noise_spread_db),
        "squelch_db": r1(state.squelch_db),
        "alarm_db": r1(state.alarm_db),
        "sens_offset_db": state.sens_offset_db,
        "last_db": r1(state.last_db) if state.last_db != NO_DATA_VALUE else None,
        "text_peak_db": r1(state.text_peak_db) if has_peak else None,
        "smoothed_steps": state.smoothed_steps,
        "peak_step": state.peak_step,
        "squelch_step": db_to_step(state.squelch_db) if state.squelch_db is not None else 0,
        "alarm_step": db_to_step(state.alarm_db) if state.alarm_db is not None else 0,
        "cpu_temp": get_cpu_temp(),
        "is_detect_mode": state.active_mode == DETECT_MODE,
        "events": [
            {"time": e["start"], "peak": round(e["peak"], 1),
             "above": round(e["above_noise"], 1), "mode": e["mode"]}
            for e in list(state.alarm_events)
        ],
    })


@app.route('/api/action', methods=['POST'])
def do_action():
    data = request.get_json(silent=True) or {}
    action = data.get('action')

    if action == "squelch_up":        # minder gevoelig
        state.sens_offset_db = clamp(state.sens_offset_db + SENS_STEP_DB, SENS_MIN_DB, SENS_MAX_DB)
    elif action == "squelch_down":    # gevoeliger
        state.sens_offset_db = clamp(state.sens_offset_db - SENS_STEP_DB, SENS_MIN_DB, SENS_MAX_DB)
    elif action == "relearn":
        state.noise_reset_requested = True
    elif action == "mode_long":
        state.active_mode = next_mode()
        restart_sdr()
    elif action == "set_gain":
        try:
            new_gain = int(data.get('value', DEFAULT_GAIN))
        except (TypeError, ValueError):
            return jsonify({"status": "error", "msg": "ongeldige gain"}), 400
        state.current_gain = clamp(new_gain, GAIN_MIN, GAIN_MAX)
        restart_sdr()
    else:
        return jsonify({"status": "error", "msg": "onbekende actie"}), 400
    return jsonify({"status": "ok"})


# ======================= OPSTARTEN =======================
def shutdown(*_):
    state.is_shutting_down = True
    stop_sdr_process()
    sys.exit(0)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, shutdown)
    threading.Thread(target=sdr_manager_thread, daemon=True).start()
    threading.Thread(target=logic_loop, daemon=True).start()
    try:
        app.run(host="0.0.0.0", port=WEB_PORT, threaded=True, use_reloader=False)
    except PermissionError:
        print(f"Geen rechten voor poort {WEB_PORT}. Start met sudo of gebruik BLUEBARK_PORT=8080.")
    finally:
        state.is_shutting_down = True
        stop_sdr_process()
