# bluebark_lite_app.py (Web Interface v5.1 - Adaptieve ruisvloer)
#
# Nieuw in v5.1 (na eerste rijtest):
#  - Alarm: 2 treffers binnen 1,5 s i.p.v. 2 sweeps direct op rij (TETRA-bursts
#    en frequentiesprongen gaven gemiste alarmen), plus direct alarm bij een
#    heel sterk signaal.
#  - Alarmlogboek: laatste 10 alarmen op de pagina + alarm_log.csv naast de app.
#  - Waarschuwing op de pagina als je niet in de detectie-mode (C2000_PORTO) staat.
#
# Nieuw t.o.v. v4:
#  - Ruisvloer wordt CONTINU gemeten (mediaan + spreiding van de laatste 20 s),
#    squelch en alarmdrempel schuiven automatisch mee met de omgeving.
#  - Alarm pas na CONFIRM_HITS metingen op rij boven de alarmdrempel (minder vals alarm).
#  - Ruis leren wordt bevroren tijdens een alarm (max 30 s), zodat een lange
#    uitzending de vloer niet omhoog trekt.
#  - Balken schalen t.o.v. de gemeten ruis i.p.v. een vaste -46 dB.
#  - Knoppen regelen nu "gevoeligheid" (offset op de auto-squelch), niet de vloer zelf.
#  - Gain-validatie, lock rond herstarts, nette afsluiting, poort instelbaar, geluid in browser.

import os
import signal
import stat
import subprocess
import sys
import threading
import time
from collections import deque
from datetime import datetime

from flask import Flask, jsonify, render_template_string, request
import bluebark_lite

# ======================= INSTELLINGEN =======================
PIPE_PATH = "/dev/shm/tetra.bin"
RTL_POWER_FFTW = "/usr/local/bin/rtl_power_fftw"
SDR_SAMPLE_RATE = 2_000_000
WEB_PORT = int(os.environ.get("BLUEBARK_PORT", "80"))

NO_DATA_VALUE = -99.0
NO_DATA_SLEEP = 0.001
LOGIC_INTERVAL = 0.05          # logica/weergave 20x per seconde
RESTART_DELAY = 0.25

DEFAULT_GAIN = 380             # tienden van dB (380 = 38 dB)
GAIN_MIN, GAIN_MAX = 0, 496
FLOOR_DB_START = -32.0         # alleen gebruikt tot de ruis is ingeleerd

# --- Adaptieve ruisvloer ---
NOISE_WINDOW_S = 20.0          # over hoeveel seconden de ruis wordt gemeten
NOISE_MIN_SAMPLES = 25         # aantal sweeps voordat detectie start (inleren)
SQUELCH_MIN_MARGIN_DB = 6.0    # squelch ligt minimaal zoveel dB boven de ruis-mediaan
SQUELCH_MAD_FACTOR = 4.0       # ...of 4x de ruisspreiding, als die groter is
NOISE_FREEZE_MAX_S = 30.0      # max. tijd dat ruis-leren bevriest tijdens alarm

# --- Alarm ---
ALARM_EXTRA_DB = 5.0           # alarmdrempel = squelch + dit
CONFIRM_HITS = 2               # zoveel treffers boven alarmdrempel...
CONFIRM_WINDOW_S = 1.5         # ...binnen deze tijd = alarm
INSTANT_ALARM_EXTRA_DB = 6.0   # 1 treffer zoveel dB boven alarmdrempel = direct alarm
DETECT_MODE = "C2000_PORTO"
ALARM_LOG_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "alarm_log.csv")
ALARM_HOLD_S = 4.0             # alarm blijft zo lang zichtbaar (voorkomt heen-en-weer springen)
SIGNAL_HOLD_S = 1.5            # "SIGNAAL" blijft zo lang staan

# --- Gevoeligheid (knoppen) ---
SENS_STEP_DB = 1.0
SENS_MIN_DB, SENS_MAX_DB = -3.0, 20.0

# --- Weergave ---
TOTAL_SIGNAL_STEPS = 13
BAR_RANGE_DB = 30.0            # volle balk = 30 dB boven de ruis
BAR_DROP_S = 0.1
PEAK_HOLD_S = 3.0
PEAK_DECAY_S = 0.15
TEXT_PEAK_HOLD_S = 2.0

SCAN_MODES = {
    # Porto's en voertuigen zenden hier (uplink) -> DE detectie-mode
    "C2000_PORTO": {"freq": "380M:385M", "bins": 256, "avg": 10, "overlap": 32, "offset": 2},
    # Masten zenden continu (downlink) -> alleen als referentie/test
    "C2000_MAST": {"freq": "390M:395M", "bins": 256, "avg": 10, "overlap": 32, "offset": 2},
    # Testen met een eigen PMR446-portofoon
    "TESTPMR": {"freq": "446M:446.2M", "bins": 256, "avg": 10, "overlap": 32, "offset": 2},
}
DEFAULT_MODE = "C2000_PORTO"
MODE_SEQUENCE = ("C2000_PORTO", "C2000_MAST", "TESTPMR")


# ======================= STATE =======================
class LiteState:
    def __init__(self):
        self.active_mode = DEFAULT_MODE
        self.current_gain = DEFAULT_GAIN
        self.sens_offset_db = 0.0
        self.is_shutting_down = False
        self.has_received_data = False

        # detectie
        self.learning = True
        self.noise_db = None
        self.noise_spread_db = 0.0
        self.squelch_db = None
        self.alarm_db = None
        self.last_db = NO_DATA_VALUE
        self.is_active = False
        self.signal_hold_mono = -1e9
        self.hit_times = deque()
        self.current_event = None
        self.alarm_events = deque(maxlen=10)
        self.alarm_hold_mono = -1e9
        self.alarm_since_mono = None
        self.current_is_alarm = False
        self.noise_reset_requested = False

        # weergave
        self.smoothed_steps = 0
        self.last_step_drop_mono = 0.0
        self.peak_step = 0
        self.peak_hold_mono = 0.0
        self.peak_decay_mono = 0.0
        self.text_peak_db = NO_DATA_VALUE
        self.text_peak_mono = 0.0

        self.display_peak_db = NO_DATA_VALUE
        self.display_peak_lock = threading.Lock()
        self.restart_lock = threading.Lock()
        self.sdr_process = None


class NoiseTracker:
    """Houdt de sweeps van de laatste NOISE_WINDOW_S seconden bij."""

    def __init__(self):
        self.samples = deque()

    def reset(self):
        self.samples.clear()

    def add(self, now, db):
        self.samples.append((now, db))
        cutoff = now - NOISE_WINDOW_S
        while self.samples and self.samples[0][0] < cutoff:
            self.samples.popleft()

    def count(self):
        return len(self.samples)

    def ready(self):
        return len(self.samples) >= NOISE_MIN_SAMPLES

    def stats(self):
        vals = sorted(v for _, v in self.samples)
        n = len(vals)
        median = vals[n // 2]
        mad = sorted(abs(v - median) for v in vals)[n // 2]  # mediane afwijking
        return median, mad


state = LiteState()
noise = NoiseTracker()
c_shared_state = bluebark_lite.SharedState(
    FLOOR_DB_START,
    SCAN_MODES[state.active_mode]["bins"],
    SCAN_MODES[state.active_mode]["offset"],
)


# ======================= HULPFUNCTIES =======================
def monotonic_now():
    return time.monotonic()


def clamp(value, lo, hi):
    return max(lo, min(hi, value))


def get_cpu_temp():
    try:
        with open("/sys/class/thermal/thermal_zone0/temp", "r") as handle:
            return round(int(handle.read()) / 1000.0, 1)
    except Exception:
        return 0.0


def ensure_fifo(path):
    if os.path.exists(path) and not stat.S_ISFIFO(os.stat(path).st_mode):
        os.remove(path)
    if not os.path.exists(path):
        os.mkfifo(path)


def stop_sdr_process():
    proc = state.sdr_process
    state.sdr_process = None
    if proc is not None and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            proc.kill()
            try:
                proc.wait(timeout=0.2)
            except subprocess.TimeoutExpired:
                pass
    subprocess.run(["pkill", "-9", "rtl_power_fftw"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def restart_sdr():
    with state.restart_lock:
        cfg = SCAN_MODES[state.active_mode]
        state.has_received_data = False
        state.noise_reset_requested = True   # na herstart opnieuw inleren
        state.smoothed_steps = 0
        state.text_peak_db = NO_DATA_VALUE
        with state.display_peak_lock:
            state.display_peak_db = NO_DATA_VALUE

        c_shared_state.max_val = NO_DATA_VALUE
        c_shared_state.floor_db = FLOOR_DB_START
        c_shared_state.bins = cfg["bins"]
        c_shared_state.offset = cfg["offset"]

        stop_sdr_process()
        time.sleep(RESTART_DELAY)
        ensure_fifo(PIPE_PATH)

        base_path = PIPE_PATH[:-4] if PIPE_PATH.endswith(".bin") else PIPE_PATH
        cmd = [
            "nice", "-n", "-10",  # hogere prioriteit (werkt alleen als root, anders genegeerd)
            RTL_POWER_FFTW, "-f", cfg["freq"], "-r", str(SDR_SAMPLE_RATE),
            "-b", str(cfg["bins"]), "-n", str(cfg["avg"]), "-o", str(cfg["overlap"]),
            "-g", str(state.current_gain), "-c", "-q", "-m", base_path,
        ]
        state.sdr_process = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def publish_display_peak(db_val):
    with state.display_peak_lock:
        if db_val > state.display_peak_db:
            state.display_peak_db = db_val


def consume_display_peak():
    with state.display_peak_lock:
        current_peak = state.display_peak_db
        state.display_peak_db = NO_DATA_VALUE
    return current_peak


def next_mode():
    idx = MODE_SEQUENCE.index(state.active_mode)
    return MODE_SEQUENCE[(idx + 1) % len(MODE_SEQUENCE)]


def db_to_step(db):
    if state.noise_db is None:
        return 0
    ratio = clamp((db - state.noise_db) / BAR_RANGE_DB, 0.0, 1.0)
    return int(round(ratio * TOTAL_SIGNAL_STEPS))


# ======================= KERNLOGICA =======================
def reset_detection():
    noise.reset()
    state.noise_reset_requested = False
    state.learning = True
    state.noise_db = None
    state.squelch_db = None
    state.alarm_db = None
    state.is_active = False
    state.hit_times.clear()
    state.alarm_since_mono = None
    state.peak_step = 0


def process_detection(now, db):
    # 1. Ruis leren (bevriezen tijdens alarm, maar nooit langer dan NOISE_FREEZE_MAX_S)
    in_alarm = (now - state.alarm_hold_mono) < ALARM_HOLD_S
    if in_alarm:
        if state.alarm_since_mono is None:
            state.alarm_since_mono = now
        frozen = (now - state.alarm_since_mono) < NOISE_FREEZE_MAX_S
    else:
        state.alarm_since_mono = None
        frozen = False
    if not frozen:
        noise.add(now, db)

    if not noise.ready():
        state.learning = True
        return
    state.learning = False

    # 2. Drempels uit de ruis berekenen
    median, mad = noise.stats()
    margin = max(SQUELCH_MIN_MARGIN_DB, SQUELCH_MAD_FACTOR * mad)
    state.noise_db = median
    state.noise_spread_db = mad
    state.squelch_db = median + margin + state.sens_offset_db
    state.alarm_db = state.squelch_db + ALARM_EXTRA_DB
    c_shared_state.floor_db = state.squelch_db

    # 3. Detectie met bevestiging
    if db >= state.squelch_db:
        state.signal_hold_mono = now
    state.is_active = (now - state.signal_hold_mono) < SIGNAL_HOLD_S
    if db >= state.alarm_db:
        state.hit_times.append(now)
    while state.hit_times and now - state.hit_times[0] > CONFIRM_WINDOW_S:
        state.hit_times.popleft()
    instant = db >= state.alarm_db + INSTANT_ALARM_EXTRA_DB
    if instant or len(state.hit_times) >= CONFIRM_HITS:
        state.alarm_hold_mono = now
        if state.current_event is None:
            state.current_event = {
                "start": datetime.now().strftime("%H:%M:%S"),
                "date": datetime.now().strftime("%Y-%m-%d"),
                "mode": state.active_mode,
                "peak": db,
                "above_noise": db - state.noise_db,
                "noise": state.noise_db,
                "squelch": state.squelch_db,
                "start_mono": now,
            }
            state.alarm_events.appendleft(state.current_event)
        elif db > state.current_event["peak"]:
            state.current_event["peak"] = db
            state.current_event["above_noise"] = db - state.noise_db


def write_alarm_log(ev, end_mono):
    try:
        new_file = not os.path.exists(ALARM_LOG_PATH)
        with open(ALARM_LOG_PATH, "a") as f:
            if new_file:
                f.write("datum,tijd,mode,peak_db,boven_ruis_db,ruis_db,squelch_db,duur_s\n")
            f.write(f"{ev['date']},{ev['start']},{ev['mode']},{ev['peak']:.1f},"
                    f"{ev['above_noise']:.1f},{ev['noise']:.1f},{ev['squelch']:.1f},"
                    f"{end_mono - ev['start_mono']:.1f}\n")
    except OSError:
        pass


def update_display(now, db):
    # db is None als er deze tick geen nieuwe sweep was -> alleen laten zakken
    target = None
    if db is not None:
        target = 0 if state.learning else db_to_step(db)

    if target is not None and target >= state.smoothed_steps:
        state.smoothed_steps = target
        state.last_step_drop_mono = now
    elif state.smoothed_steps > 0 and (now - state.last_step_drop_mono) > BAR_DROP_S:
        state.smoothed_steps -= 1
        state.last_step_drop_mono = now

    if state.smoothed_steps >= state.peak_step:
        state.peak_step = state.smoothed_steps
        state.peak_hold_mono = now
    elif state.peak_step > 0 and (now - state.peak_hold_mono) > PEAK_HOLD_S:
        if (now - state.peak_decay_mono) > PEAK_DECAY_S:
            state.peak_step -= 1
            state.peak_decay_mono = now

    if db is not None:
        if db >= state.text_peak_db or (now - state.text_peak_mono) > TEXT_PEAK_HOLD_S:
            state.text_peak_db = db
            state.text_peak_mono = now


def update_logic(db_val):
    if state.is_shutting_down:
        return
    now = monotonic_now()

    if state.noise_reset_requested:
        reset_detection()

    has_new = state.has_received_data and db_val != NO_DATA_VALUE
    if has_new:
        state.last_db = db_val
        process_detection(now, db_val)

    update_display(now, db_val if has_new else None)
    state.current_is_alarm = (now - state.alarm_hold_mono) < ALARM_HOLD_S

    if state.current_event is not None and not state.current_is_alarm:
        write_alarm_log(state.current_event, now)
        state.current_event = None


def logic_loop():
    while not state.is_shutting_down:
        update_logic(consume_display_peak())
        time.sleep(LOGIC_INTERVAL)


def sdr_manager_thread():
    restart_sdr()
    threading.Thread(target=bluebark_lite.c_sdr_data_thread, args=(c_shared_state,), daemon=True).start()

    while not state.is_shutting_down:
        db_val = c_shared_state.consume_peak()
        if db_val == NO_DATA_VALUE:
            time.sleep(NO_DATA_SLEEP)
            continue
        state.has_received_data = True
        publish_display_peak(db_val)
        time.sleep(0.01)


def status_text():
    if not state.has_received_data:
        return "GEEN DATA"
    if state.learning:
        return "INLEREN"
    if state.current_is_alarm:
        return "ALARM"
    if state.is_active:
        return "SIGNAAL"
    return "RUSTIG"


def r1(value):
    return None if value is None else round(value, 1)


